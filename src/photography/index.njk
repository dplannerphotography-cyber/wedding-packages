    {# 
      ==========================================================================
      PORTFOLIO SVG GALLERY & LIGHTBOX (PRESERVED CODE)
      Hidden until Samuel adds real photos to src/assets/portfolio/
      Specs: .jpg or .webp, 800x1000px, 4:5 vertical orientation
      ==========================================================================
      {%- for item in portfolio %}
      <article class="portfolio-folio-item" data-category="{{ item.category }}" data-caption="{{ item.caption }}" data-cta-link="{{ item.ctaLink }}" data-cta-text="{{ item.ctaText }}">
        <div class="folio-media-box folio-lightbox-trigger" tabindex="0" role="button" aria-label="View {{ item.title }} full screen">
          <img src="{{ item.image }}" alt="{{ item.alt }}" width="800" height="1000" loading="lazy" decoding="async">
          <span class="folio-tag">{{ item.tag }}</span>
          <div class="folio-overlay-hint" aria-hidden="true">
            <span class="folio-zoom-badge"><i class="fa-solid fa-expand"></i> View Larger</span>
          </div>
        </div>
        <div class="folio-details">
          <div>
            <h4>{{ item.title }}</h4>
            <p class="folio-desc">{{ item.caption }}</p>
            <p class="folio-specs"><i class="fa-solid fa-camera"></i> {{ item.specs }}</p>
          </div>
          <div>
            <a href="{{ item.ctaLink }}" class="btn-gold-link"{% if item.ctaLink.startsWith('http') %} target="_blank" rel="noopener noreferrer"{% endif %}>
              <span>{{ item.ctaText }}</span> &rarr;
            </a>
          </div>
        </div>
      </article>
      {%- endfor %}
    #}

  </div>
</section>

