{# Promo countdown. Hidden until the script has a real value; replaced by the ended message at zero. #}
<div class="countdown-wrapper" data-countdown hidden>
  <span class="countdown-label">PROMO BOOKINGS CLOSE IN:</span>
  <div class="countdown-grid">
    <div class="countdown-item"><span data-cd="days">--</span><small>Days</small></div>
    <div class="countdown-item"><span data-cd="hours">--</span><small>Hours</small></div>
    <div class="countdown-item"><span data-cd="minutes">--</span><small>Mins</small></div>
    <div class="countdown-item"><span data-cd="seconds">--</span><small>Secs</small></div>
  </div>
</div>
