<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ page.url | absUrl }}">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="author" content="{{ site.name }}">
  <meta name="theme-color" content="#6e1628">
  <meta name="geo.region" content="NG-OY">
  <meta name="geo.placename" content="Yemetu, Ibadan">

  {%- set shareImage = (ogImage or "/assets/og/home.png") | absUrl %}
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ ogTitle or title }}">
  <meta property="og:description" content="{{ ogDescription or description }}">
  <meta property="og:image" content="{{ shareImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:url" content="{{ page.url | absUrl }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="en_NG">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ ogTitle or title }}">
  <meta name="twitter:description" content="{{ ogDescription or description }}">
  <meta name="twitter:image" content="{{ shareImage }}">

  {# Hide promo content straight away once the promo is over, before the page paints #}
  <script>
    window.DP_PROMO_END = "{{ site.promo.ends }}";
    if (Date.now() > new Date(window.DP_PROMO_END).getTime()) document.documentElement.classList.add("promo-ended");
  </script>
  {%- if legacyHashRedirect %}
  {# Old flyer, brochure and WhatsApp links pointed at sections of the old one-page site #}
  <script>
    (function () {
      var moved = ["packages", "comparison", "addon", "how-to-book", "terms", "essential", "classic", "signature"];
      function forward() {
        var hash = location.hash.replace("#", "");
        if (moved.indexOf(hash) !== -1) location.replace("/weddings/#" + hash);
      }
      forward();
      window.addEventListener("hashchange", forward);
    })();
  </script>
  {%- endif %}

  <script type="application/ld+json">
{{ site | businessSchema | jsonld | safe }}
  </script>
  {%- if pageFaqs %}
  <script type="application/ld+json">
{{ pageFaqs | faqSchema | jsonld | safe }}
  </script>
  {%- endif %}
  {%- if breadcrumbs %}
  <script type="application/ld+json">
{{ breadcrumbs | breadcrumbSchema(site) | jsonld | safe }}
  </script>
  {%- endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@1,400&display=swap" rel="stylesheet">
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/assets/css/site.css">
  {%- if extraCss %}
  <link rel="stylesheet" href="{{ extraCss }}">
  {%- endif %}
</head>
<body>
  {% include "partials/header.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
  <script src="/assets/js/site.js" defer></script>
  {%- if extraJs %}
  <script src="{{ extraJs }}" defer></script>
  {%- endif %}
</body>
</html>
