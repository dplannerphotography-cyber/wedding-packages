---
layout: layouts/base.njk
extraCss: /assets/css/blog.css
ogType: article
---

<article class="post-article">
  <div class="container">
    
    <!-- Breadcrumb Navigation -->
    <nav class="breadcrumb" aria-label="Breadcrumb" style="margin-bottom: 28px;">
      <a href="/">Home</a> <span aria-hidden="true">/</span>
      <a href="/blog/">Journal</a> <span aria-hidden="true">/</span>
      <span aria-current="page">{{ title }}</span>
    </nav>

    <!-- Post Editorial Header -->
    <header class="post-header">
      {%- if category %}
      <span class="post-kicker">{{ category }}</span>
      {%- endif %}
      <h1 class="post-title">{{ title }}</h1>
      {%- if lead %}
      <p class="post-lead">{{ lead }}</p>
      {%- endif %}

      <div class="post-meta-strip">
        <div class="post-author-box">
          <span class="post-author-avatar"><i class="fa-solid fa-camera" aria-hidden="true"></i></span>
          <span>By {{ author or site.leadPhotographer }}</span>
        </div>
        <span>&bull;</span>
        <time datetime="{{ date | dateIso }}">{{ date | dateReadable }}</time>
        <span>&bull;</span>
        <span>{{ content | readingTime }}</span>
        {%- if readingLevel %}
        <span>&bull;</span>
        <span>{{ readingLevel }}</span>
        {%- endif %}
      </div>
    </header>

    {%- if heroImage %}
    <div class="post-hero-media">
      <img src="{{ heroImage }}" alt="{{ heroAlt or title }}" width="900" height="520" fetchpriority="high" decoding="async">
      {%- if heroCaption %}
      <div class="post-hero-caption">{{ heroCaption }}</div>
      {%- endif %}
    </div>
    {%- endif %}

    <!-- Article Body Content -->
    <div class="post-content">
      {{ content | safe }}

      <!-- Contextual Call-to-Action Card -->
      <section class="post-cta-card" aria-label="Action and Inquiry">
        <h3>{{ ctaTitle or "Planning an upcoming wedding or session in Ibadan?" }}</h3>
        <p>{{ ctaText or "Speak with Samuel Damilare directly on WhatsApp to check date availability, request sample galleries, or discuss custom requirements." }}</p>
        <div class="post-cta-actions">
          <a href="{{ (ctaWaMsg or "Hello DPlanner Photography! I read your article on " + title + " and would like to discuss a photography booking.") | wa }}" class="btn btn-card-featured" target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-whatsapp" aria-hidden="true"></i> {{ ctaBtnText or "Chat on WhatsApp" }}
          </a>
          {%- if ctaPackageLink %}
          <a href="{{ ctaPackageLink }}" class="btn btn-outline">
            <span>{{ ctaPackageLabel or "View Package Details" }}</span> &rarr;
          </a>
          {%- endif %}
        </div>
      </section>
    </div>

    <!-- Related Articles -->
    <section class="related-posts-section" aria-label="Related Articles">
      <h3 class="related-posts-heading">More from the DPlanner Journal</h3>
      <div class="related-posts-grid">
        {%- set count = 0 %}
        {%- for post in collections.posts %}
          {%- if post.url != page.url and count < 2 %}
            {%- set count = count + 1 %}
            <a href="{{ post.url }}" class="related-post-card">
              <div class="post-card-body">
                <span class="label-over" style="font-size:0.72rem; margin-bottom:4px;">{{ post.data.category or "Guide" }}</span>
                <h4>{{ post.data.title }}</h4>
                <p>{{ post.data.description | truncate(110) }}</p>
                <span class="post-card-link">Read Guide &rarr;</span>
              </div>
            </a>
          {%- endif %}
        {%- endfor %}
      </div>
    </section>

  </div>
</article>

<!-- BlogPosting JSON-LD Schema -->
<script type="application/ld+json">
{{ {
  title: title,
  description: description,
  ogImage: ogImage,
  date: date,
  dateModified: dateModified,
  author: author
} | blogPostingSchema(site, page.url) | jsonld | safe }}
</script>

<!-- Breadcrumb JSON-LD Schema -->
<script type="application/ld+json">
{{ [
  { name: "Home", url: "/" },
  { name: "Journal", url: "/blog/" },
  { name: title, url: page.url }
] | breadcrumbSchema(site) | jsonld | safe }}
</script>
